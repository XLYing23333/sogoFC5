#!/bin/sh
set -eu
runtime=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
case "${1-}" in
    '') record=status.json ;;
    --learning) record=learning.json ;;
    *) printf '%s\n' 'Usage: sogo-fc5-direct-status [--learning]' >&2; exit 2 ;;
esac
if [ -f "$runtime/sogo-fc5-direct/$record" ]; then
    cat "$runtime/sogo-fc5-direct/$record"
else
    printf '%s\n' 'Sogo-FC5 has no matching status record. Log in again and add the input method first.' >&2
    exit 1
fi
